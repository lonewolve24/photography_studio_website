# =============================================================================
# Shotz Photography Studio — Environment Variables
# =============================================================================
#
# LOCAL DEVELOPMENT
#   1. Copy this file to the repo root as `.env` (same folder as this file):
#        cp .env.example .env
#   2. Fill in your values in `.env` (never commit `.env` — it is gitignored)
#   3. Export variables before running Django, OR use a tool like direnv / python-dotenv
#      Note: Django does not load `.env` automatically unless you wire that up.
#
# RAILWAY (PRODUCTION)
#   Do NOT upload `.env` to Railway.
#   Add these variables in: Railway → Your Service → Variables
#   PostgreSQL vars (PG*) are usually injected automatically when you link a Postgres plugin.
#
# =============================================================================


# --- Django core ---

# Set to False in production
DEBUG=True

# Optional: logging verbosity (DEBUG, INFO, WARNING, ERROR)
DJANGO_LOG_LEVEL=INFO


# --- PostgreSQL (production only — Railway injects these when DB is linked) ---

PGDATABASE=
PGUSER=
PGPASSWORD=
PGHOST=
PGPORT=5432


# --- DigitalOcean Spaces — media file storage (production only) ---
# Used when DEBUG=False. These power uploaded photos/videos in the admin & gallery.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=


# --- Resend — contact form emails ---

# API key from https://resend.com/api-keys
RESEND_API_KEY=

# Must use your verified Resend domain (e.g. info.shotz.gm)
# Example: RESEND_FROM_EMAIL=Shotz <hello@info.shotz.gm>
RESEND_FROM_EMAIL=Shotz <onboarding@resend.dev>

# Optional fallback inbox if Site Settings email is not set in Django admin
# Example: CONTACT_TO_EMAIL=yourname@gmail.com
CONTACT_TO_EMAIL=


# --- One-time admin bootstrap (optional — Railway/local setup only) ---
# Used by: python manage.py create_superuser_with_password

ADMIN_USER=
ADMIN_EMAIL=
ADMIN_PASSWORD=
